  NEXT_PUBLIC_CLARITY_ID="CLARITY_ID"
  RESEND_API_KEY="re_xxxxxxxx"
  RESEND_AUDIENCE_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# Juegos (/juegos): backend de Movo y API key del cliente demo (gateway, DEMO_API_KEYS).
# Solo server-side: nunca con prefijo NEXT_PUBLIC_.
MOVO_API_URL="https://api-dev.movosend.app"
MOVO_DEMO_API_KEY="xxxxxxxx"
# PIN de 6 dígitos para entrar a /juegos (iPads del stand). Sin PIN: abierto en dev, cerrado en producción.
JUEGOS_PIN="000000"
# Trivia de la feria (/trivia + /juegos/trivia): proyecto de Supabase propio del evento.
# La service role key es solo server-side; la anon key solo escucha el canal broadcast `trivia`.
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="xxxxxxxx"
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxxxxx"
# URL que codifica el QR de la TV (en dev, sin esto, usa el origen actual).
NEXT_PUBLIC_TRIVIA_URL="https://movosend.app/trivia"
